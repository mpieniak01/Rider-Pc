    "constraints": [
      {
        "id": "direction_range",
        "rule": "minimum <= maximum"
      },
      {
        "id": "direction_speed",
        "rule": "speed == 0 or minimum <= speed <= maximum"
      },
      {
        "id": "direction_step",
        "rule": "step > 0; zero-width range permits a disabled slider"
      },
      {
        "id": "pulse_minimum",
        "rule": "minimum <= duration / (1/acceleration + 1/deceleration)"
      }
    ],
    "ramp_modes": [
      {
        "value": 0,
        "label_pl": "Liniowy",
        "label_en": "Linear"
      },
      {
        "value": 1,
